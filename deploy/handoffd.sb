(version 1)

(import "bsd.sb")

(allow process-exec*
  (literal "@HOME@/.local/bin/handoffd")
  (subpath "/opt/homebrew")
  (literal "/usr/bin/git")
  (literal "/usr/bin/ssh")
  (literal "/usr/bin/osascript")
  (literal "/bin/ps")
  (subpath "/usr/libexec/git-core")
  (subpath "/Library/Developer/CommandLineTools"))

(allow process-fork)
(allow network-outbound)
(allow network-bind)
(allow mach-lookup)
(allow sysctl-read)

(allow file-read*
  (subpath "/Library/Developer")
  (subpath "/opt/homebrew")
  (subpath "/private/etc")
  (subpath "/private/var/folders"))

(deny file-read* (subpath "@HOME@"))
(deny file-write* (subpath "@HOME@"))

(allow file-read*
  (literal "@HOME@")
  (literal "@HOME@/.local/bin/handoffd")
  (literal "@HOME@/.gitconfig")
  (subpath "@HOME@/.ssh")
  (subpath "@HOME@/.orbstack/ssh")
  (subpath "@HOME@/.config/git")
  (subpath "@HOME@/.config/handoffd")
  (subpath "@HOME@/.local/share/uv")
  (subpath "@HOME@/.local/state/handoffd")
  (subpath "@HOME@/.cache/uv")
  (subpath "@HOME@/projects")
  (subpath "@HOME@/Library/Keychains")
  (subpath "@HOME@/Library/Application Support/glab-cli")
  (subpath "@HOME@/.config/gh")
  (subpath "@HOME@/Library/Containers/com.tinyspeck.slackmacgap/Data/Library/Application Support/Slack/logs")
  (subpath "@HOME@/Library/Application Support/Slack/logs")
  (subpath "@HOME@/.config/herdr")
  (subpath "@HOME@/.config/cmux")
  (subpath "@HOME@/.local/state/cmux")
  (subpath "@HOME@/.cmuxterm"))

(allow file-write*
  (subpath "/private/var/folders")
  (subpath "@HOME@/.cache/uv")
  (subpath "@HOME@/.local/state/handoffd")
  (subpath "@HOME@/Library/Logs")
  (subpath "@HOME@/Library/Keychains")
  (subpath "@HOME@/Library/Application Support/glab-cli")
  (subpath "@HOME@/.config/gh")
  (subpath "@HOME@/.config/herdr")
  (subpath "@HOME@/.config/cmux")
  (subpath "@HOME@/.local/state/cmux")
  (subpath "@HOME@/.cmuxterm")
  (regex #"^@HOME@/projects/[^/]+/\.git($|/)")
  (regex #"^@HOME@/projects/[^/]+/\.claude/worktrees($|/)"))
